rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /midterm-mobile/avatars/{filename} {
      allow get: if isAdmin();
      allow create: if isAdmin()
        && resource == null
        && filename.matches('[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}\\.jpg')
        && request.resource.size > 0
        && request.resource.size <= 500 * 1024
        && request.resource.contentType == 'image/jpeg';
      // API chỉ dọn ảnh sau khi kiểm tra không còn hồ sơ tham chiếu.
      allow update, delete, list: if false;
    }

    // Giữ nguyên rule cũ đã hết hạn, không gia hạn quyền public.
    match /{allPaths=**} {
      allow read, write: if request.time < timestamp.date(2026, 8, 3);
    }
  }
}
