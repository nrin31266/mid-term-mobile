  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "emulators": "firebase emulators:start --project demo-memberdesk --only auth,firestore,storage",
    "api:emulator": "MEMBERDESK_ENV=emulator FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 node server/index.mjs",
    "api:cloud": "MEMBERDESK_ENV=cloud node server/index.mjs",
    "seed:emulator": "MEMBERDESK_ENV=emulator FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 node scripts/seed-admin.mjs",
    "test": "node --test tests/access.test.mjs tests/config.test.mjs",
    "test:firebase": "firebase emulators:exec --project demo-memberdesk --only auth,firestore,storage \"MEMBERDESK_ENV=emulator node --test --test-concurrency=1 tests/rules.test.mjs tests/auth-integration.test.mjs\"",
    "seed:cloud": "MEMBERDESK_ENV=cloud node scripts/seed-admin.mjs",
    "build:web:cloud": "EXPO_PUBLIC_FIREBASE_MODE=cloud EXPO_PUBLIC_API_URL=https://memberdesk-801885728284.web.app/api expo export --platform web",
    "web:emulator": "EXPO_PUBLIC_FIREBASE_MODE=emulator EXPO_PUBLIC_API_URL=http://127.0.0.1:3001 expo start --web"
  },
  "private": true
